{
  "experiment": {
    "name": "mid_expert_sslam_36",
    "task": "single_label_noise_classification",
    "num_classes": 36,
    "seed": 2026
  },
  "dataset": {
    "path": "/marimo/dataset/mix-dataset",
    "manifest_file": "manifest.csv",
    "labels_file": "labels.txt",
    "clip_seconds": 4.0,
    "sample_rate": 16000,
    "train_split": "train",
    "validation_split": "validation",
    "test_split": "test"
  },
  "backbone": {
    "model_id": "ta012/SSLAM_pretrain",
    "embedding_dim": 768,
    "num_mel_bins": 128,
    "norm_divisor": 2.0
  },
  "run": "run2_ce_only",
  "mid_band_db": [5.0, 10.0],
  "teacher": {
    "source_column": "noise_path",
    "head_epochs": 20,
    "head_lr": 0.001,
    "head_batch_size": 512,
    "head_patience": 3,
    "extract_batch_size": 32,
    "finetune_epochs": 8,
    "trainable_blocks": 6,
    "head_ft_lr": 0.0001,
    "encoder_lr": 1e-05,
    "batch_size": 16,
    "validation_batch_size": 32,
    "accumulation_steps": 2,
    "gradient_clip_norm": 5.0,
    "patience": 3,
    "workers": 4,
    "checkpoint": "teacher_noise_best.pt"
  },
  "student": {
    "source_column": "mixture_path",
    "finetune_epochs": 6,
    "trainable_blocks": 6,
    "head_lr": 0.0001,
    "encoder_lr": 1e-05,
    "film_lr": 0.001,
    "batch_size": 16,
    "validation_batch_size": 32,
    "accumulation_steps": 2,
    "gradient_clip_norm": 5.0,
    "patience": 3,
    "workers": 4,
    "film": {
      "enabled": true,
      "hidden": 128,
      "snr_jitter_db": 2.0,
      "placement": "pooled"
    }
  },
  "loss": {
    "r_ce": 1.0,
    "a_kd": 0.0,
    "b_crd": 0.0,
    "rho_kd": 4.0,
    "tau_nce": 0.07,
    "proj_dim": 128,
    "n_negatives": 1024,
    "negative_mode": "different_label",
    "crd_level": "patch",
    "_note": "crd_level 'patch' aligns every patch token against the teacher's; 'pooled' reproduces the BEATs project's single-vector CRD. patch is the reason for switching backbones - see VERSIONS.md. Weights r/a/b come from the CRD reference repo (-r 1 -a 1 -b 0.8); do not invent replacements."
  },
  "gates": {
    "teacher_acc_floor": 0.75,
    "baseline_mid_accuracy": 0.6681,
    "baseline_mid_macro_f1": 0.6602
  },
  "outputs": {
    "dir": "artifacts",
    "embedding_cache": "teacher_emb.pt",
    "history": "teacher_history.json",
    "summary": "teacher_summary.json"
  },
  "runtime": {
    "device": "cuda",
    "pin_memory": true,
    "smoke_test": false,
    "smoke_train_rows": 400,
    "smoke_validation_rows": 200
  }
}
