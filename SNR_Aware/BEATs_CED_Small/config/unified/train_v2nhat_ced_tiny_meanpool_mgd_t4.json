{
  "paths": {
    "dataset": "../../.agents/mix-dataset-v2",
    "frcrn_checkpoint": "model/frcrn_best.pt",
    "frcrn_config": "config/frcrn.yaml",
    "student_config": "config/unified/kdmoe_ced_tiny_meanpool_mgd.yaml",
    "group_map": "config/group_map.json",
    "membership": "config/membership.npy",
    "teacher_cache": "output/teacher_nhat_v2/beats_teacher_logits_nhat_v2.pt",
    "frcrn_cache_dir": "output/frcrn_cache_fp32",
    "output": "output/unified/v2nhat_ced_tiny_meanpool_mgd_t4",
    "validation_exclude_noise_ytids": "config/audioset_train_noise_ytids.txt",
    "teacher_hints": "output/teacher_nhat_v2/teacher_hints_l12_nhat.npy"
  },
  "data": {
    "load_noise": false,
    "train_split": "train",
    "validation_split": "validation",
    "clip_seconds": 4.0,
    "num_workers": 4,
    "paired_units_per_batch": 32
  },
  "runtime": {
    "device": "auto",
    "smoke_samples": 32,
    "seed": 2026
  },
  "loss": {
    "kd_temperature": 4.0
  },
  "relationkd": {
    "fkd_method": "mgd",
    "fkd_weight": 7e-05,
    "fkd_mask_ratio": 0.5,
    "grad_probe_every": 50,
    "stop_after_epochs": 0
  },
  "_note_v2": "Bản v2 (không nhiễu sạch, load_noise false, teacher nghe n_hat): chỉ đổi dataset / teacher / đường dẫn; còn lại như config gốc."
}
