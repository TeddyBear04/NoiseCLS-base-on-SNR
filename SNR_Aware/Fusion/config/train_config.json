{
  "experiment": {
    "name": "fusion_36_all_branches",
    "task": "single_label_noise_classification",
    "num_classes": 36,
    "seed": 2026
  },
  "dataset": {
    "path": "/marimo/dataset/mix-dataset",
    "manifest_file": "manifest.csv",
    "labels_file": "labels.txt",
    "clip_seconds": 4.0,
    "sample_rate": 16000,
    "train_split": "train",
    "validation_split": "validation",
    "test_split": "test"
  },
  "branches": {
    "beats_low": {
      "pretrained": "../BEATs_Experts/checkpoint/pretrained/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2.pt",
      "expert_checkpoint": "../BEATs_Experts/checkpoint/low_snr/audio_best_36.pt",
      "embedding_dim": 768,
      "snr_min_db": -5.0,
      "snr_max_db": 0.0
    },
    "beats_mid": {
      "pretrained": "../BEATs_Experts/checkpoint/pretrained/BEATs_iter3_plus_AS2M_finetuned_on_AS2M_cpt2.pt",
      "expert_checkpoint": "../BEATs_Experts/checkpoint/mid_snr/audio_best_36.pt",
      "embedding_dim": 768,
      "snr_min_db": 5.0,
      "snr_max_db": 10.0
    },
    "dpcrn_high": {
      "checkpoint": "../DPCRN_Noise_Target/checkpoint/dpcrn_noise_target_best.pt",
      "embedding_dim": 256,
      "snr_min_db": 15.0,
      "snr_max_db": 20.0
    }
  },
  "model": {
    "architecture": "FusionClassifier",
    "fusion_input_dim": 1792,
    "num_classes": 36
  },
  "training": {
    "epochs": 50,
    "batch_size": 64,
    "workers": 4,
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 5.0,
    "selection_metric": "macro_f1",
    "patience": 10,
    "checkpoint": "checkpoint/fusion_36_best.pt",
    "results": "checkpoint/fusion_36_history.json",
    "embedding_cache_dir": "artifacts/embedding_cache_36"
  },
  "evaluation": {
    "split": "test",
    "output": "checkpoint/test_metrics_36.json",
    "per_snr": true,
    "metrics": [
      "accuracy",
      "macro_precision",
      "macro_recall",
      "macro_f1",
      "micro_f1",
      "macro_map",
      "balanced_accuracy",
      "macro_auc_ovr"
    ]
  },
  "runtime": {
    "device": "cuda",
    "pin_memory": true
  }
}
