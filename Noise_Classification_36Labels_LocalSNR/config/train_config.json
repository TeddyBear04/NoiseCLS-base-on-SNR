{
  "epochs": 100,
  "batch_size": 32,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "monitor": "macro_f1",
  "early_stopping": true,
  "patience": 15,
  "delta": 0.0001,
  "cache_audio": false,
  "num_workers": -1,
  "pin_memory": true,
  "threshold": 0.5,
  "use_pos_weight": false,
  "max_pos_weight": 20.0,
  "random_seed": 2026,
  "ckpt_dir": "checkpoint_36_labels_local_snr",
  "profile_model": false,
  "snr_bands": [
    {
      "name": "-5dB",
      "min_db": -5.0,
      "max_db": -5.0
    },
    {
      "name": "0dB",
      "min_db": 0.0,
      "max_db": 0.0
    },
    {
      "name": "5dB",
      "min_db": 5.0,
      "max_db": 5.0
    },
    {
      "name": "10dB",
      "min_db": 10.0,
      "max_db": 10.0
    },
    {
      "name": "15dB",
      "min_db": 15.0,
      "max_db": 15.0
    },
    {
      "name": "20dB",
      "min_db": 20.0,
      "max_db": 20.0
    }
  ],
  "model": {
    "backbone": "Cnn14MobileV2LocalSNR",
    "pretrained": false,
    "classes_num": 36
  },
  "local_snr": {
    "enabled": true,
    "segment_seconds": 0.5,
    "segment_hop_seconds": 0.25,
    "speech_activity_db_below_peak": -40.0,
    "min_target_db": -20.0,
    "max_target_db": 30.0,
    "target_offset_db": 5.0,
    "target_scale_db": 15.0,
    "hidden_dim": 128,
    "dropout": 0.2,
    "loss": "huber",
    "loss_weight": 0.1,
    "inference_smoothing_points": 3
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/36_labels",
    "signal_type": "mixture",
    "train_directory": "train",
    "validation_directory": "validation",
    "test_directory": "test",
    "selected_labels_file": "labels.txt",
    "use_predefined_splits": true,
    "include_video": false,
    "save_results": false,
    "seed": 2026,
    "split_strategy": "predefined_manifest",
    "evaluation_mode": "holdout",
    "dynamic_snr_enabled": true,
    "dynamic_snr_probability": 0.5,
    "dynamic_snr_min_db": -5.0,
    "dynamic_snr_max_db": 20.0,
    "dynamic_snr_control_seconds": 0.5,
    "clean_directory": "clean",
    "noise_directory": "noise"
  },
  "audio_features": {
    "sample_rate": 16000,
    "clip_seconds": 4.0,
    "inference_hop_seconds": 2.0,
    "window_size": 512,
    "hop_size": 160,
    "mel_bins": 128,
    "fmin": 20,
    "fmax": 8000,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2
  }
}
